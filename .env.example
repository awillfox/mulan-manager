# Backend base URL (NO trailing slash). Dev: local Go server. Prod: tailnet MagicDNS host.
BACKEND_URL=http://localhost:8080
# Tailscale userspace HTTP proxy. Empty in dev (direct). Prod: http://127.0.0.1:1055
TS_HTTP_PROXY=
# Tailscale auth key (prod/render only; ephemeral + tagged). Empty in dev.
TS_AUTHKEY=
# Music player (bookyman-remote) login URL, no query string. On-prem behind the
# cloudflared tunnel. Dashboard fires a warm-up ping here on open.
PUBLIC_BOOKYMAN_URL=https://bookyman.thgalleycafe.com/login
# Magic-link key for the Music Player nav link (bookyman-remote's ADMIN_PASSWORD).
# PUBLIC_ => it reaches the browser and is visible in the rendered href. That is
# inherent to a magic link; the manager login is the real gate. Empty = plain link.
PUBLIC_BOOKYMAN_KEY=
