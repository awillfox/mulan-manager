# Backend base URL (NO trailing slash). Dev: local Go server. Prod: tailnet MagicDNS host.
BACKEND_URL=http://localhost:8080
# Tailscale userspace HTTP proxy. Empty in dev (direct). Prod: http://127.0.0.1:1055
TS_HTTP_PROXY=
# Tailscale auth key (prod/render only; ephemeral + tagged). Empty in dev.
TS_AUTHKEY=
# Music player (bookyman-remote) URL. Dashboard fires a keep-alive ping here on
# open to wake its free-tier Render dyno. Public PUBLIC_ var (reaches the browser).
PUBLIC_BOOKYMAN_URL=https://bookyman-remote.onrender.com/login
